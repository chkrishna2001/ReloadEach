<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ReloadEach</AssemblyName>
    <TargetName>ReloadEach</TargetName>
    <RootNamespace>ReloadEach</RootNamespace>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DeployExtension>false</DeployExtension>
    <CreateVsixContainer>true</CreateVsixContainer>
    <TargetVsixContainerName>ReloadEach.vsix</TargetVsixContainerName>
    <TargetVsixContainer>$(OutputPath)$(TargetVsixContainerName)</TargetVsixContainer>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CreatePkgDefAssemblyToProcess>$(OutputPath)$(TargetFramework)\$(AssemblyName).dll</CreatePkgDefAssemblyToProcess>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.10.40171" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.11.414" GeneratePathProperty="true">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" />
    <None Include="Images\Icon-16x16.png" />
    <None Include="Images\Icon-32x32.png" />
    <None Include="Images\Icon-64x64.png" />
    <VSIXSourceItem Include="Images\Icon-16x16.png">
      <VSIXSubPath>Resources</VSIXSubPath>
    </VSIXSourceItem>
    <VSIXSourceItem Include="Images\Icon-32x32.png">
      <VSIXSubPath>Resources</VSIXSubPath>
    </VSIXSourceItem>
    <VSIXSourceItem Include="Images\Icon-64x64.png">
      <VSIXSubPath>Resources</VSIXSubPath>
    </VSIXSourceItem>
    <VSIXSourceItem Include="..\ReleaseNotes.md">
      <TargetPath>Resources\ReleaseNotes.md</TargetPath>
      <IncludeInVSIX>true</IncludeInVSIX>
    </VSIXSourceItem>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="Commands\Commands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <Import Project="$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets" Condition="'$(PkgMicrosoft_VSSDK_BuildTools)' != '' and Exists('$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets')" />
  <Import Project="$(VsSDKInstall)\Microsoft.VsSDK.targets" Condition="'$(PkgMicrosoft_VSSDK_BuildTools)' == '' and '$(VsSDKInstall)' != '' and Exists('$(VsSDKInstall)\Microsoft.VsSDK.targets')" />

  <Target Name="BuildVsixContainer" AfterTargets="Build" DependsOnTargets="GeneratePkgDef;CreateVsixContainer" />

  <Target Name="RemoveExistingVsixContainer" BeforeTargets="CreateVsixContainer">
    <Delete Files="$(TargetVsixContainer)" TreatErrorsAsWarnings="true" />
  </Target>

</Project>
